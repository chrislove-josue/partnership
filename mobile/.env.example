# Adresse de l'API Laravel.
# Le code accepte le HTTP uniquement en développement pour localhost / 10.0.2.2.
# Une release doit TOUJOURS utiliser une URL HTTPS.
# Émulateur Android : http://10.0.2.2:8000/api
# Simulateur iOS : http://localhost:8000/api
# Téléphone physique : utilisez une URL HTTPS (ex. https://api.exemple.fr/api).
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api
