{
  "expo": {
    "name": "FinanceMobile",
    "slug": "finance-mobile",
    "version": "1.5.9",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.churchmanager.benin",
      "permissions": [
        "INTERNET"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F2B46"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "fdac1fad-d7c6-4a20-9a32-c3ed265a61e5"
      }
    },
    "owner": "chrislove-josue"
  }
}
